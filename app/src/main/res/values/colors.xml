<resources>

    <color name="background_invalid">#ffff0000</color>
    <color name="background_valid">#ff0026ff</color>
    <color name="background_needs_attention">#ffffff00</color>
    <color name="black_transp_70">#b2000000</color>
    <color name="text_light">#ff000000</color>
    <color name="text_dark">#fff3f3f3</color>
    <color name="text_secondary_light">#ff555555</color>
    <color name="text_secondary_dark">#ffa5a5a5</color>
    <color name="toolbar_light">#ffe0e0e0</color>
    <color name="toolbar_dark">#ff0f0f0f</color>
    <color name="icon_light">@android:color/black</color>
    <color name="icon_dark">@android:color/white</color>
    <color name="icon_background_light">#20000000</color>
    <color name="icon_background_dark">#20ffffff</color>
    <color name="icon_active">#ffff0000</color>
    <color name="dot_light">#aa000000</color>
    <color name="dot_dark">#aaffffff</color>
    <color name="ic_notification_background_color">@android:color/white</color>

    <!-- Snackbar: inverse surface (dark) for LightAppTheme — makes it visually distinct -->
    <color name="snackbar_background_light">#FF323232</color>
    <color name="snackbar_text_light">#FFFFFFFF</color>
    <!-- AppCompat light accent stays in-family and readable on the dark snackbar -->
    <color name="snackbar_action_light">#FF00CD8C</color>

    <!-- Snackbar: inverse surface (light) for DarkAppTheme — makes it visually distinct -->
    <color name="snackbar_background_dark">#FFE8E8E8</color>
    <color name="snackbar_text_dark">#FF1A1A1A</color>
    <!-- AppCompat dark accent stays in-family and readable on the light snackbar -->
    <color name="snackbar_action_dark">#FF00695C</color>

</resources>
